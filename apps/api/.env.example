# Copy to .env and adjust. All timestamps are stored in UTC.

# PostgreSQL (source of truth). Sync psycopg driver.
DATABASE_URL=postgresql+psycopg://swarmops@localhost:5432/swarmops

# Separate database used by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://swarmops@localhost:5432/swarmops_test

# Centralized demo pacing between workflow steps (milliseconds).
# Lower this (e.g. 150) for a faster live demo; 0 makes it instant.
DEMO_EVENT_DELAY_MS=650

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

APP_ENV=development

# --- LLM agents (Sprint 2) ---
# "auto" picks the first provider whose key is set (Claude -> OpenAI -> Gemini),
# else the deterministic Mock. Force one with: claude | openai | gemini | mock.
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# Set ONE of these to use a real model (leave all unset to run entirely on Mock):
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-latest
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# --- Sponsor integrations (all optional; each degrades to Mock / local no-op) ---
# See docs/sponsors.md for what each plugs into and how to enable it.

# Pioneer (Fastino) — OpenAI-compatible model routing / adaptive inference.
# Enable by setting the key, then LLM_PROVIDER=pioneer (or leave "auto").
# PIONEER_KEY=...
PIONEER_MODEL=gemma
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_ADAPTIVE=true

# Band — communication layer for AI agents. Inter-agent messages + governance
# events are mirrored to a Band room. Create an External Agent at app.band.ai/agents,
# copy the key + agent UUID, and optionally pre-create a room and set BAND_CHAT_ID.
# BAND_API_KEY=band-...
# BAND_AGENT_ID=...
# BAND_CHAT_ID=...
BAND_BASE_URL=https://app.band.ai/api/v1

# Senso — context layer for AI agents. Agents retrieve/ingest verified context.
# SENSO_API_KEY=...
SENSO_BASE_URL=https://api.senso.ai/v1

# cited.md (Senso) — publish the finished mission report to the agentic web
# (real action). Without a key the report is still generated and served at
# GET /api/missions/{id}/report; with a key it is published to cited.md.
# CITED_API_KEY=...
CITED_BASE_URL=https://cited.md/api
