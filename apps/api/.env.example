# Copy to .env and adjust. Everything is OPTIONAL: with no keys, Ring runs on the
# documented Playground simulator and Bedrock perception runs on a deterministic
# Mock, so the full /sentinel guided demo works out of the box. Sentinel's state is
# in-process — there is no database.

APP_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- Ring sensing layer ---
# Provider: auto (developer if configured, else simulator) | developer | simulator | mock
RING_PROVIDER=auto
# Real Ring Partner API credentials (developer.amazon.com/docs/ring). Optional.
# RING_CLIENT_ID=...
# RING_CLIENT_SECRET=...
# RING_WEBHOOK_SECRET=...          # HMAC-SHA256 key for X-Signature verification
# RING_ACCESS_TOKEN=...
RING_API_BASE=https://api.amazonvision.com

# --- Bedrock perception layer (AWS Builder). AWS creds come from the standard
#     boto3 chain (AWS_ACCESS_KEY_ID / AWS_PROFILE / role), not from this file. ---
# Provider: auto (Bedrock if a model id + boto3 are present, else Mock) | bedrock | mock
PERCEPTION_PROVIDER=auto
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0   # a us.* inference profile may be required
BEDROCK_REGION=us-east-1
PERCEPTION_TIMEOUT_MS=12000
PERCEPTION_MIN_CONFIDENCE=0.5
